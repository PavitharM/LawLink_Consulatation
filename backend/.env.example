NODE_ENV=development
PORT=5001

# MySQL connection. Percent-encode special characters in the password (@ -> %40, # -> %23, ...).
#   Homebrew MySQL (root, no password):  mysql://root@127.0.0.1:3306/lawlink
#   Docker (root `npm run db:up`):        mysql://root:lawlink@127.0.0.1:3307/lawlink
DATABASE_URL="mysql://root@127.0.0.1:3306/lawlink"

# Each must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-32-chars

# Browser origins allowed by CORS, comma-separated (web app, Expo web)
CLIENT_URL=http://localhost:5173,http://localhost:8081

# Needed only for profile-picture uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
